# Polymarket Arbitrage Bot Configuration
# Copy this file to .env and fill in your values

# Your wallet private key (ONLY needed if you want to execute trades)
# WARNING: Never share your private key or commit it to git!
# To get this from MetaMask:
# 1. Click the three dots menu
# 2. Go to Account Details
# 3. Click "Show Private Key"
# 4. Enter your password and copy the key
POLYMARKET_PRIVATE_KEY=your_private_key_here

# Optional: Notification settings (for future features)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
